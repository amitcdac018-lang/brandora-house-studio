# ----- Database -----
# PostgreSQL connection string. Use a managed provider (Neon, Supabase, RDS, etc.) in production.
DATABASE_URL="postgresql://user:password@localhost:5433/brandora?schema=public"

# ----- Auth.js (NextAuth v5) -----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ----- Razorpay (test/sandbox keys — never commit live keys) -----
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="replace-with-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-webhook-secret"
# Public key exposed to the client for Razorpay Checkout widget only (never the secret)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# ----- Shiprocket (real carrier booking + tracking — optional) -----
# Your Shiprocket API user email/password (create a dedicated API user in
# Shiprocket Settings > API, do not reuse your main login if avoidable).
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# Must exactly match a pickup location label configured in your Shiprocket account.
SHIPROCKET_PICKUP_LOCATION=""
# Shared secret you choose and also paste into Shiprocket's webhook config (x-api-key header).
SHIPROCKET_WEBHOOK_TOKEN=""

# ----- Twilio Verify (phone/OTP login — optional) -----
TWILIO_ACCOUNT_SID=""
# Preferred: an API Key (Console > Account > API keys & tokens > Create API key).
# Scoped and revocable independently of your main account credentials.
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
# Legacy alternative to the API Key pair above — only needed if you don't use an API Key.
TWILIO_AUTH_TOKEN=""
# From Twilio Console > Verify > Services (the service you create for this app).
TWILIO_VERIFY_SERVICE_SID=""

# ----- Image storage (configure one) -----
# Example: Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ----- App -----
NODE_ENV="development"
APP_BASE_URL="http://localhost:3000"

# ----- Rate limiting (optional — Upstash Redis recommended in production) -----
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
